# Chiave API Anthropic per gli agenti LLM (Claude).
# Lasciala vuota per eseguire in modalità offline con fallback euristico.
ANTHROPIC_API_KEY=

# Modalità di esecuzione: paper | live  (default: paper — nessun ordine reale)
TRADING_MODE=paper

# Modello LLM primario e di fallback.
LLM_MODEL=claude-opus-4-8
LLM_FALLBACK_MODEL=claude-sonnet-4-6
